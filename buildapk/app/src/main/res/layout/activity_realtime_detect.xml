<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 摄像头预览 -->
    <SurfaceView
        android:id="@+id/cameraView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 检测框覆盖层 -->
    <com.yolo.openiris.ui.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部状态栏 -->
    <LinearLayout
        android:id="@+id/topStatusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="top"
        android:padding="12dp"
        android:background="#80000000"
        android:gravity="center_vertical">

        <!-- 返回按钮 -->
        <ImageButton
            android:id="@+id/buttonBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            app:tint="@android:color/white" />

        <!-- FPS 显示 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/textFps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FPS: --"
            android:textColor="#FFFFFF"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:gravity="center" />

        <!-- AI 状态指示器 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/textAiStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI: 关闭"
            android:textColor="#AAAAAA"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:layout_marginEnd="8dp" />

        <!-- 全屏切换按钮 -->
        <ImageButton
            android:id="@+id/buttonFullscreen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_crop"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="全屏"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- 右侧控制按钮组 -->
    <LinearLayout
        android:id="@+id/rightControlPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:orientation="vertical"
        android:layout_marginEnd="12dp"
        android:background="#80000000"
        android:padding="8dp">

        <!-- 切换摄像头 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSwitchCamera"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@android:drawable/ic_menu_camera"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            style="@style/Widget.Material3.Button.IconButton"
            app:iconTint="@android:color/white" />

        <!-- GPU/CPU 切换 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonToggleGpu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="GPU"
            android:textSize="10sp"
            android:textColor="@android:color/white"
            style="@style/Widget.Material3.Button.TonalButton" />

        <!-- AI 开关 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonToggleAi"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="AI"
            android:textSize="10sp"
            android:textColor="#AAAAAA"
            style="@style/Widget.Material3.Button.TonalButton" />
    </LinearLayout>

    <!-- 底部结果汇总面板 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/resultSummaryCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#F0F4F8"
        android:layout_margin="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 汇总标题栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="检测结果汇总"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/textWindowDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15秒窗口"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- YOLO 识别卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardYolo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#2196F3"
                app:cardBackgroundColor="#E3F2FD">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="YOLO 识别"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textStyle="bold"
                            android:textColor="#1565C0" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/textYoloCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="#1565C0" />
                    </LinearLayout>

                    <com.google.android.flexbox.FlexboxLayout
                        android:id="@+id/flexboxYolo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:flexWrap="wrap"
                        app:justifyContent="flex_start" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- AI 识别卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#9C27B0"
                app:cardBackgroundColor="#F3E5F5">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="AI 识别"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textStyle="bold"
                            android:textColor="#7B1FA2" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/textAiCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="#7B1FA2" />
                    </LinearLayout>

                    <com.google.android.flexbox.FlexboxLayout
                        android:id="@+id/flexboxAi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:flexWrap="wrap"
                        app:justifyContent="flex_start" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 综合分析卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCombined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#4CAF50"
                app:cardBackgroundColor="#E8F5E9">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="综合分析"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textStyle="bold"
                            android:textColor="#2E7D32" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/textCombinedCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="#2E7D32" />
                    </LinearLayout>

                    <com.google.android.flexbox.FlexboxLayout
                        android:id="@+id/flexboxCombined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:flexWrap="wrap"
                        app:justifyContent="flex_start" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
